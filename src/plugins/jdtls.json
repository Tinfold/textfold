{
  "id": "jdtls",
  "name": "Eclipse JDT",
  "about": "Types, completions and fixes for Java",
  "needs": [
    "jdtls"
  ],
  "install": [
    {
      "about": "jdtls, with brew",
      "run": [
        "brew",
        "install",
        "jdtls"
      ],
      "unless": "jdtls",
      "system": true
    }
  ],
  "uninstall": [
    {
      "run": [
        "brew",
        "uninstall",
        "jdtls"
      ],
      "system": true
    }
  ],
  "see": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
  "languages": {
    "java": {
      "servers": [
        {
          "name": "jdtls",
          "command": "jdtls",
          "roots": [
            "pom.xml",
            "build.gradle",
            "build.gradle.kts",
            "settings.gradle",
            "settings.gradle.kts",
            ".git"
          ],
          "settings": {
            "java": {
              "configuration": {
                "updateBuildConfiguration": "automatic"
              },
              "completion": {
                "importOrder": [
                  "java",
                  "javax",
                  "com",
                  "org"
                ],
                "guessMethodArguments": true
              },
              "signatureHelp": {
                "enabled": true,
                "description": {
                  "enabled": true
                }
              },
              "implementationsCodeLens": {
                "enabled": false
              },
              "referencesCodeLens": {
                "enabled": false
              },
              "inlayHints": {
                "parameterNames": {
                  "enabled": "literals"
                }
              },
              "format": {
                "enabled": true
              },
              "autobuild": {
                "enabled": true
              },
              "import": {
                "maven": {
                  "enabled": true
                },
                "gradle": {
                  "enabled": true
                }
              },
              "maven": {
                "downloadSources": true
              },
              "eclipse": {
                "downloadSources": true
              },
              "references": {
                "includeDecompiledSources": true
              },
              "contentProvider": {
                "preferred": "fernflower"
              }
            }
          },
          "init_options": {
            "extendedClientCapabilities": {
              "classFileContentsSupport": true,
              "advancedOrganizeImportsSupport": true,
              "resolveAdditionalTextEditsSupport": true
            }
          }
        }
      ]
    }
  }
}
