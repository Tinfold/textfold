{
  "id": "gopls",
  "name": "gopls",
  "about": "Types, completions and fixes for Go",
  "needs": [
    "gopls"
  ],
  "install": [
    {
      "about": "gopls, with go install",
      "run": [
        "go",
        "install",
        "golang.org/x/tools/gopls@latest"
      ],
      "unless": "gopls"
    },
    {
      "about": "gopls, with brew",
      "run": [
        "brew",
        "install",
        "gopls"
      ],
      "unless": "gopls",
      "system": true
    }
  ],
  "see": "https://pkg.go.dev/golang.org/x/tools/gopls#section-readme",
  "languages": {
    "go": {
      "servers": [
        {
          "name": "gopls",
          "command": "gopls",
          "roots": [
            "go.mod",
            "go.work",
            ".git"
          ]
        }
      ]
    }
  }
}
