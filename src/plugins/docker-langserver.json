{
  "id": "docker-langserver",
  "name": "docker-langserver",
  "about": "Completions and warnings for Dockerfiles",
  "needs": ["docker-langserver"],
  "install": [
    {
      "about": "dockerfile-language-server-nodejs, from npm",
      "run": ["npm", "install", "--global", "dockerfile-language-server-nodejs"],
      "unless": "docker-langserver"
    }
  ],
  "uninstall": [
    { "run": ["npm", "uninstall", "--global", "dockerfile-language-server-nodejs"] }
  ],
  "see": "https://github.com/rcjsuen/dockerfile-language-server",
  "languages": {
    "dockerfile": {
      "servers": [
        {
          "name": "docker-langserver",
          "command": "docker-langserver",
          "args": ["--stdio"]
        }
      ]
    }
  }
}
