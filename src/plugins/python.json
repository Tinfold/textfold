{
  "id": "python",
  "name": "Python",
  "about": "Colours, pyright for types, ruff for lint and formatting",
  "languages": {
    "python": {
      "extensions": [
        "py",
        "pyi",
        "pyw"
      ],
      "shebangs": [
        "python",
        "python3"
      ],
      "line_comment": "#",
      "grammar": {
        "built_in": "python"
      },
      "servers": [
        {
          "name": "pyright",
          "command": "pyright-langserver",
          "args": [
            "--stdio"
          ],
          "roots": [
            "pyproject.toml",
            "setup.py",
            "setup.cfg",
            "requirements.txt",
            ".git"
          ],
          "env": {
            "VIRTUAL_ENV": "${venv}",
            "PATH": "${venv_bin}:${env:PATH}"
          },
          "settings": {
            "python": {
              "pythonPath": "${python}",
              "defaultInterpreterPath": "${python}",
              "analysis": {
                "autoSearchPaths": true,
                "useLibraryCodeForTypes": true,
                "diagnosticMode": "openFilesOnly"
              }
            }
          }
        },
        {
          "name": "ruff",
          "command": "ruff",
          "args": [
            "server"
          ],
          "roots": [
            "pyproject.toml",
            "ruff.toml",
            ".ruff.toml",
            ".git"
          ],
          "env": {
            "VIRTUAL_ENV": "${venv}",
            "PATH": "${venv_bin}:${env:PATH}"
          },
          "settings": {
            "settings": {
              "interpreter": [
                "${python}"
              ]
            }
          }
        }
      ]
    }
  }
}
