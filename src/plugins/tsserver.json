{
  "id": "tsserver",
  "name": "TypeScript server",
  "about": "Types and completions for JavaScript, TypeScript and TSX",

  "_about": [
    "One server for three languages, which is what it always was — it was",
    "written out three times because there was nowhere else to put it."
  ],

  "needs": ["typescript-language-server"],
  "install": [
    {
      "about": "typescript-language-server, from npm",
      "run": ["npm", "install", "--global", "typescript", "typescript-language-server"],
      "unless": "typescript-language-server"
    }
  ],
  "uninstall": [
    { "run": ["npm", "uninstall", "--global", "typescript-language-server"] }
  ],
  "see": "https://github.com/typescript-language-server/typescript-language-server",
  "languages": {
    "javascript": {
      "servers": [
        {
          "name": "tsserver",
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "roots": ["package.json", "tsconfig.json", "jsconfig.json", ".git"]
        }
      ]
    },
    "typescript": {
      "servers": [
        {
          "name": "tsserver",
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "roots": ["package.json", "tsconfig.json", ".git"]
        }
      ]
    },
    "tsx": {
      "servers": [
        {
          "name": "tsserver",
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "roots": ["package.json", "tsconfig.json", ".git"]
        }
      ]
    }
  }
}
