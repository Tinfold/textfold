{
  "id": "omnisharp",
  "name": "OmniSharp",
  "about": "Types and completions for C#",
  "needs": [
    "OmniSharp"
  ],
  "install": [
    {
      "about": "OmniSharp, with brew",
      "run": [
        "brew",
        "install",
        "omnisharp-roslyn"
      ],
      "unless": "OmniSharp",
      "system": true
    }
  ],
  "see": "https://github.com/OmniSharp/omnisharp-roslyn/releases",
  "languages": {
    "csharp": {
      "servers": [
        {
          "name": "omnisharp",
          "command": "OmniSharp",
          "args": [
            "-lsp"
          ],
          "roots": [
            "*.sln",
            "*.slnx",
            "*.csproj",
            "global.json",
            ".git"
          ],
          "settings": {
            "omnisharp": {
              "enableEditorConfigSupport": true,
              "enableImportCompletion": true,
              "organizeImportsOnFormat": true,
              "enableRoslynAnalyzers": true
            }
          }
        }
      ]
    }
  }
}
