{
  "id": "toml",
  "name": "TOML",
  "about": "Colours, and taplo",
  "languages": {
    "toml": {
      "extensions": [
        "toml"
      ],
      "filenames": [
        "Cargo.lock"
      ],
      "line_comment": "#",
