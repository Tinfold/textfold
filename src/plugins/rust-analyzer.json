{
  "id": "rust-analyzer",
  "name": "rust-analyzer",
  "about": "Types, completions and fixes for Rust",
  "needs": [
    "rust-analyzer"
  ],
  "install": [
    {
      "about": "rust-analyzer, as a rustup component",
      "run": [
        "rustup",
        "component",
        "add",
        "rust-analyzer"
      ],
      "unless": "rust-analyzer",
      "system": true
    },
    {
      "about": "rust-analyzer, with brew",
      "run": [
        "brew",
        "install",
        "rust-analyzer"
      ],
      "unless": "rust-analyzer",
      "system": true
    }
  ],
  "uninstall": [
    {
      "run": [
        "rustup",
        "component",
        "remove",
        "rust-analyzer"
      ],
      "system": true
    }
  ],
  "see": "https://rust-analyzer.github.io/manual.html#installation",
  "languages": {
    "rust": {
      "servers": [
        {
          "name": "rust-analyzer",
          "command": "rust-analyzer",
          "roots": [
            "Cargo.toml",
            "rust-project.json",
            ".git"
          ],
          "settings": {
            "rust-analyzer": {
              "check": {
                "command": "clippy"
              },
              "cargo": {
                "features": "all"
              },
              "completion": {
                "callable": {
                  "snippets": "fill_arguments"
                },
                "postfix": {
                  "enable": true
                }
              },
              "inlayHints": {
                "typeHints": {
                  "enable": true
                },
                "parameterHints": {
                  "enable": true
                }
              },
              "procMacro": {
                "enable": true
              },
              "workspace": {
                "symbol": {
                  "search": {
                    "scope": "workspace_and_dependencies",
                    "kind": "all_symbols"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
